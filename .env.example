# Kopieer dit bestand naar .env.local en vul je eigen Supabase-gegevens in.
# .env.local wordt niet meegestuurd naar GitHub (staat in .gitignore).
# Laat de regels leeg om de app zonder backend te draaien.

# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=
# Supabase → Project Settings → API Keys → anon public (of de "publishable" key)
# NOOIT de service_role / secret key hier invullen.
VITE_SUPABASE_ANON_KEY=
